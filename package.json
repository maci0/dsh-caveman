{
  "name": "dsh-caveman",
  "version": "0.11.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "description": "Caveman terse-talk mode, for DeepSeek Harness: bundled skills, an always-on compression ruleset, and a Plugin configuration card.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.8 <0.2.0"
    }
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "skills",
    "scripts/sync-upstream.mjs",
    "sync.manifest.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "sync:check": "node scripts/sync-upstream.mjs check",
    "sync": "node scripts/sync-upstream.mjs sync"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-skill": "~0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "~0.1.7-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings-plugins": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-brand": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-sandbox": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-scope": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-skill": "~0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "~0.1.7-rc.2",
    "@deepseek-ai/dsh-util-values": "0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maci0/dsh-caveman.git"
  },
  "icon": "./icon.svg"
}
